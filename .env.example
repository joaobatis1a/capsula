# Copie para .env.local e preencha. Nunca commite valores reais.

# Fonte de dados das campanhas: mock | csv | api
DATA_SOURCE=mock

# Só com DATA_SOURCE=csv: o CSV de campanhas da empresa e o mapping.yaml que liga as colunas dele (docs/dados-reais.md)
# CSV_CAMPANHAS=mocks/campanhas-exemplo.csv
# CSV_MAPPING=mocks/mapping.exemplo.yaml

# Modelo de linguagem: o motor usa a primeira chave preenchida, nesta ordem,
# e passa para a próxima se uma recusar. Sem nenhuma, gera com moldes fixos (sem IA).
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Opcional: troca o modelo de cada provedor
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# GEMINI_MODEL=gemini-3.5-flash-lite
# Modelos de reserva do Gemini, na ordem, para quando o principal responde 503 ou 429
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite

# Supabase (a chave de serviço só no servidor)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
