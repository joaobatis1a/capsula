# Copie para .env.local e preencha. Nunca commite valores reais.

# Fonte de dados das campanhas: mock | csv | api
DATA_SOURCE=mock

# Modelo de linguagem (Groq, com OpenRouter de reserva)
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Supabase (a chave de serviço só no servidor)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
