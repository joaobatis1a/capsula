# Copie para .env.local e preencha. Nunca commite valores reais.

# Fonte de dados das campanhas: mock | csv | api
DATA_SOURCE=mock

# Modelo de linguagem: o motor usa a primeira chave preenchida, nesta ordem,
# e passa para a próxima se uma recusar. Sem nenhuma, gera com moldes fixos (sem IA).
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Opcional: troca o modelo de cada provedor
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# GEMINI_MODEL=gemini-3.5-flash

# Supabase (a chave de serviço só no servidor)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
